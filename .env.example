# Copy to .env, fill in, then: chmod 600 .env
# .env must never be committed (it is listed in .gitignore).

# Login for the web page
GAVEL_USERNAME=
# Generate with: python3 gavel_meeting_tool.py --hash-password
GAVEL_PASSWORD_HASH=
# Any long random string, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
GAVEL_SECRET_KEY=
